<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<!--
  식당 식기 배열 퍼즐: dining_table_closeup.png (1619x971 → 720x432).
  접시 주변 4개 슬롯(왼쪽, 위쪽, 오른쪽, 오른쪽 위)에 놓인 식기를 클릭으로 선택·교체해 정답 배열을 맞춘다.
-->
<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="escape.DiningTablePuzzleController">

    <VBox alignment="CENTER" spacing="8">
        <Label fx:id="infoLabel" styleClass="puzzle-text" wrapText="true" maxWidth="700"
               text="식기를 클릭해 선택한 뒤 다른 식기를 클릭하면 자리가 바뀐다. 올바른 위치에 배열하라."/>

        <Pane fx:id="board" prefWidth="720" prefHeight="432"
              minWidth="720" minHeight="432" maxWidth="720" maxHeight="432">
            <Rectangle width="720" height="432" fill="#3a352d" stroke="#8a7a5c" strokeWidth="2"/>
            <ImageView fx:id="background" fitWidth="720" fitHeight="432"/>

            <!-- 1. 왼쪽 슬롯 -->
            <StackPane fx:id="leftSlot" layoutX="140" layoutY="120" prefWidth="96" prefHeight="250"
                       minWidth="96" minHeight="250" maxWidth="96" maxHeight="250"/>

            <!-- 2. 위쪽 슬롯 -->
            <StackPane fx:id="topSlot" layoutX="250" layoutY="18" prefWidth="220" prefHeight="86"
                       minWidth="220" minHeight="86" maxWidth="220" maxHeight="86"/>

            <!-- 3. 오른쪽 슬롯 -->
            <StackPane fx:id="rightSlot" layoutX="488" layoutY="165" prefWidth="96" prefHeight="225"
                       minWidth="96" minHeight="225" maxWidth="96" maxHeight="225"/>

            <!-- 4. 오른쪽 위 슬롯 -->
            <StackPane fx:id="topRightSlot" layoutX="482" layoutY="18" prefWidth="148" prefHeight="134"
                       minWidth="148" minHeight="134" maxWidth="148" maxHeight="134"/>
        </Pane>

        <Label fx:id="statusLabel" styleClass="puzzle-text" wrapText="true" maxWidth="700"
               style="-fx-text-fill: #f0c060;"/>

        <HBox alignment="CENTER" spacing="12">
            <Button fx:id="viewPaintingButton" text="복원된 그림 보기" styleClass="clue-button"
                    onAction="#onShowPainting"/>
            <Button fx:id="resetButton" text="초기화" styleClass="clue-button"
                    onAction="#onReset"/>
            <Button fx:id="checkButton" text="배열 확인" styleClass="clue-button"
                    onAction="#onCheck"/>
        </HBox>
    </VBox>

    <!-- 복원된 그림 확인용 내부 오버레이 (기존 식기 배치 상태를 초기화하지 않음) -->
    <VBox fx:id="paintingOverlay" visible="false" alignment="CENTER" spacing="12"
          style="-fx-background-color: rgba(20, 18, 15, 0.94); -fx-padding: 18; -fx-border-color: #8a7a5c; -fx-border-width: 2;">
        <Label text="복원된 식기 정물화" styleClass="overlay-title"/>
        <ImageView fx:id="completePaintingView" fitWidth="460" fitHeight="345"
                   preserveRatio="true" smooth="true"/>
        <Button text="퍼즐로 돌아가기" styleClass="clue-button" onAction="#onClosePainting"/>
    </VBox>
</StackPane>
